// ==========================================================
// Barter Trading Platform — Prisma Schema (MVP)
// Prisma v7 — datasource URL lives in prisma.config.ts, NOT here.
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------
// ENUMS
// ----------------------------------------------------------

enum Role {
  CUSTOMER
  BUSINESS
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

enum ListingStatus {
  ACTIVE
  PAUSED
}

enum TransactionStatus {
  SUCCESS
  FAILED // e.g. insufficient balance / wrong PIN
}

enum FeeType {
  MONTHLY_FEE
  TRADE_COMMISSION
}

// ----------------------------------------------------------
// USER & AUTH
// ----------------------------------------------------------

model User {
  id        String         @id @default(uuid())
  name      String
  email     String         @unique
  password  String
  role      Role           @default(CUSTOMER)
  country   String // used for currency display + filters
  status    ApprovalStatus @default(PENDING)

  // Transaction PIN security (separate from login password)
  transactionPin   String? // bcrypt-hashed, set after approval
  pinSetAt         DateTime?
  failedPinAttempts Int      @default(0)
  pinLockedUntil   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessProfile   BusinessProfile?
  customerProfile   CustomerProfile?
  wallet            Wallet?
  listings          Listing[]
  sentTransactions  Transaction[]     @relation("SenderTransactions")
  recvTransactions  Transaction[]     @relation("ReceiverTransactions")
  monthlyFeeLogs    MonthlyFeeLog[]
  pinResetTokens    PinResetToken[]
  currencyRateEdits CountryCurrencyRate[] @relation("RateUpdatedBy")

  @@map("users")
}

// Separate table so a business can have multiple documents without
// bloating the User row.
model BusinessProfile {
  id                 String         @id @default(uuid())
  userId             String         @unique
  businessName       String
  category           String
  phone              String?
  address            String?
  city               String?
  logoUrl            String?
  verificationStatus ApprovalStatus @default(PENDING)
  verifiedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents BusinessDocument[]

  @@map("business_profiles")
}

model BusinessDocument {
  id                String   @id @default(uuid())
  businessProfileId String
  fileUrl           String
  fileType          String // e.g. "registration_certificate"
  uploadedAt        DateTime @default(now())

  businessProfile BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  @@map("business_documents")
}

// Customer completes this after signup — mirrors BusinessProfile
// so both roles have a dedicated "complete your profile" step.
model CustomerProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  phone          String?
  address        String?
  city           String?
  profilePicture String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

// ----------------------------------------------------------
// WALLET (Trade Dollars)
// ----------------------------------------------------------

model Wallet {
  id           String   @id @default(uuid())
  userId       String   @unique
  balance      Decimal  @default(0) @db.Decimal(14, 2) // in Trade Dollars
  creditLimit  Decimal  @default(0) @db.Decimal(14, 2) // starting limit set by admin
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

// Single-row ledger that collects all commission + monthly fees.
// Enforce single row at the application layer (e.g. fixed known id).
model CompanyAccount {
  id           String   @id @default(uuid())
  totalBalance Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt    DateTime @updatedAt

  @@map("company_account")
}

// ----------------------------------------------------------
// LISTINGS
// ----------------------------------------------------------

model Listing {
  id          String        @id @default(uuid())
  businessId  String
  title       String
  description String
  price       Decimal       @db.Decimal(14, 2) // in Trade Dollars
  category    String
  imageUrl    String?
  status      ListingStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business User @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([businessId])
  @@map("listings")
}

// ----------------------------------------------------------
// TRANSACTIONS (Trade Dollar transfers via QR)
// ----------------------------------------------------------

model Transaction {
  id         String             @id @default(uuid())
  senderId   String
  receiverId String

  amount           Decimal @db.Decimal(14, 2) // amount before commission
  commissionBuyer  Decimal @db.Decimal(14, 2) // 5% deducted from buyer
  commissionSeller Decimal @db.Decimal(14, 2) // 5% deducted from seller
  netAmountToSeller Decimal @db.Decimal(14, 2) // amount - commissionSeller

  status    TransactionStatus @default(SUCCESS)
  receiptId String            @unique @default(uuid())

  createdAt DateTime @default(now())

  sender   User @relation("SenderTransactions", references: [id], fields: [senderId])
  receiver User @relation("ReceiverTransactions", references: [id], fields: [receiverId])

  @@index([senderId])
  @@index([receiverId])
  @@map("transactions")
}

// Log of all deductions going into the CompanyAccount — monthly fees
// AND trade commissions — for audit/reporting.
model MonthlyFeeLog {
  id     String  @id @default(uuid())
  userId String
  amount Decimal @db.Decimal(14, 2) // e.g. fixed $10
  type   FeeType @default(MONTHLY_FEE)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("fee_logs")
}

// ----------------------------------------------------------
// TRANSACTION PIN — forgot-PIN flow
// ----------------------------------------------------------

model PinResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pin_reset_tokens")
}

// ----------------------------------------------------------
// MULTI-CURRENCY (admin-controlled, display only)
// ----------------------------------------------------------

model CountryCurrencyRate {
  id             String   @id @default(uuid())
  countryName    String   @unique
  currencyCode   String // e.g. THB, LBP
  currencySymbol String // e.g. ฿, ل.ل
  rate           Decimal  @db.Decimal(14, 4) // 1 Trade Dollar = X local currency
  updatedById    String
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  updatedBy User @relation("RateUpdatedBy", fields: [updatedById], references: [id])

  @@map("country_currency_rates")
}
